# Server-side only. Copy to .env.local for local development, or set in the Vercel project.
# The key is never shipped to the browser (PLAN.md §11.1).
ANTHROPIC_API_KEY=

# To use OpenAI instead of Anthropic, set both of these:
# VITE_AI_PROVIDER=openai
# OPENAI_API_KEY=
# VITE_AI_PROVIDER is read by the server and by the page (so the consent prompt names the right
# provider); it is not a secret. The key itself is server-side only. Restart the dev server after changing either.

# Optional. Set to "off" to disable the server-side refusal fallback for synthesis calls.
# AI_REFUSAL_FALLBACK=off

# Optional, OpenAI only. Set to "off" if the configured model rejects explicit prompt-cache breakpoints.
# AI_OPENAI_CACHE_BREAKPOINT=off
