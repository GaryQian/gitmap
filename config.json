{
  "app": { "title": "Starmap" },
  "settings": { "particles": true },
  "theme": {
    "fonts": { "ui": "Jost", "code": "Commit Mono" },
    "dark": { "void": "#1C1C1C", "dustCool": "#4B5158", "dustWarm": "#6B5A4C", "text": "#EDEFF2", "halo": "#9FD8FF", "warm": "#FFD9A0", "sidebar": "#141414", "surface": "#1C1C1C" },
    "light": { "void": "#F6F8FC", "dustCool": "#D3DAE3", "dustWarm": "#F3DCC6", "text": "#1E2126", "halo": "#2A6FDB", "warm": "#E8A23A", "sidebar": "#FFFFFF", "surface": "#FFFFFF" },
    "pill": { "opacity": 0.6, "borderOpacity": 0.14, "blurPx": 10, "cardRadiusPx": 20 },
    "wisps": { "contrast": 0.25, "driftSpeed": 0.02, "parallax": 0.05, "stars": false }
  },
  "scheduler": {
    "workerShare": 0.5, "maxWorkers": 14, "memoryCapMB": 2048, "memoryPerWorkerMB": 140, "deviceMemoryShare": 0.5,
    "threadsPerCore": 2, "busyAppThreads": 2, "reserveCores": 1,
    "taskTargetMs": 40, "parseFloorWorkers": 1, "historyChunkCommits": 200, "parkWhenFrameMsOver": 20
  },
  "parser": {
    "version": "4",
    "source": "pack", "packChunkBytes": 1048576, "batchBytes": 2097152, "maxFileBytes": 1048576, "retainBytes": 268435456,
    "excerptBytes": 4096, "slowBatchBytes": 262144, "signatureChars": 200, "docChars": 300,
    "exclude": [
      "**/vendor/**", "**/node_modules/**", "**/third_party/**", "**/dist/**",
      "**/*.min.js", "**/*.min.css", "**/*.map",
      "**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml", "**/*.lock",
      "**/*.generated.*", "**/*.pb.go", "**/*_pb2.py"
    ],
    "binaryExtensions": [
      "png", "jpg", "jpeg", "gif", "webp", "avif", "ico", "bmp", "tiff", "psd", "pdf", "zip", "gz", "tar", "7z", "jar", "war",
      "class", "so", "dll", "dylib", "exe", "bin", "o", "a", "lib", "wasm", "woff", "woff2", "ttf", "otf", "eot",
      "mp3", "mp4", "mov", "wav", "ogg", "webm", "avi", "db", "sqlite", "pyc", "icns", "keystore", "tflite", "pb",
      "npy", "npz", "h5", "onnx"
    ],
    "includeUntracked": false, "workingTreeCheck": true,
    "bridges": ["jni", "protobuf"]
  },
  "reveal": { "maxWaitSeconds": 30, "perFileTimeoutMs": 2000, "settleMaxMs": 3000, "settleMsPerFile": 0.2, "settleCeilingMs": 12000, "growMs": 2000 },
  "history": { "maxCommits": 50000, "timeBudgetSeconds": 20, "merges": "skip", "pageBytes": 262144, "pageCacheBytes": 67108864, "objectCacheBytes": 33554432, "progressIntervalMs": 250 },
  "persist": { "snapshotDebounceMs": 2000 },
  "clustering": {
    "citiesPerDecade": 3.5, "cityOffset": -2.2, "minCities": 1, "maxCities": 20,
    "districtsPerDecade": 3.5, "districtOffset": -2.2, "minDistrictSize": 5, "sizeBias": 0.5, "splitModularity": 0.3, "mergeCoupling": 0.4,
    "resolution": 1.0, "seed": 1, "directoryAffinity": 0.3, "pathBias": 0, "mergePathBias": 0, "hubDamping": true,
    "countSlack": 1.5, "incrementalMaxNew": 0.2
  },
  "importance": { "damping": 0.85, "maxIterations": 100, "tolerance": 1e-9 },
  "analysis": { "topSymbolsPerEdge": 5 },
  "physics": {
    "sliceMs": 8, "reheat": 0.3, "velocityDecay": 0.6, "settleTicks": 150, "alphaMin": 0.001,
    "packing": 0.5, "containStrength": 0.5, "dragAlphaTarget": 0.3, "resetMs": 600, "loopHz": 60, "postHz": 30,
    "settleReserve": 0.15, "radiusEpsAbs": 0.25, "radiusEpsRel": 0.02, "overlapTolerance": 0.95, "offFocusEvery": 2,
    "updateTicks": 45, "relaxTicks": 200, "relaxSpeed": 0.05, "radiusEase": 0.2, "pushTicks": 10,
    "settleFullShare": 0.65, "squeezeTicks": 150, "squeezeAlpha": 0.5,
    "city": { "gap": 40, "linkStrength": 0.5, "charge": -60, "gravity": 0.02 },
    "district": { "pad": 6, "linkStrength": 0.6, "externalPull": 0.15, "externalPullScale": 0.05, "lloyd": 0.1, "gravity": 0.1, "cellWeight": 1, "reach": 1.08, "cellEps": 0.5 },
    "file": { "pad": 0.5, "gap": 2, "radialExtent": 0.85, "sizeVsConnectivity": 0.5, "baseStrength": 0.1, "fill": 0.72, "pack": 0.72, "spread": 0.08, "spreadTicks": 40, "finishRounds": 60 }
  },
  "visual": {
    "radiusMin": 0.8, "radiusMax": 12, "sizeScale": 0.8, "imageBytesPerLine": 400, "importanceBoost": 0.5, "importanceCurve": 2,
    "glowFromPct": 0.9, "selectedScale": 1.3,
    "languageColors": {
      "ts": "#3178c6", "js": "#e8c53a", "python": "#3fa672", "c": "#7d8fa6", "cpp": "#d9486e", "objc": "#5aa9e6",
      "java": "#e0803a", "kotlin": "#a97bff", "scala": "#d73a4a", "csharp": "#2fb37c", "go": "#00add8", "rust": "#dea584",
      "dart": "#2bb7f6", "swift": "#f05138", "php": "#8892bf", "ruby": "#cc342d", "lua": "#5b6ee1", "luau": "#00a2ff","vue": "#41b883", "svelte": "#ff5d2a",
      "astro": "#b845ed", "css": "#c6538c", "html": "#e34c26", "image": "#e6dcc3", "other": "#8a9099"
    },
    "grid": { "cell": 50, "opacity": 0.06 },
    "star": { "coreGain": [2.4, 5.0], "coreTightness": [13, 8], "limbDarkening": 0.62, "flicker": 0.07, "glowFalloff": [16, 1.4], "glowCurve": 2.5, "spikesFromPct": 0.975, "breatheMs": 1500 },
    "particles": { "ambient": 1500, "voidDustShare": 0.2, "selectBurst": 40, "openBurst": 150 },
    "edgePulse": { "speed": 120, "tailLength": 30, "restSeconds": [0.5, 2.4], "flickerHz": 10, "traceOpacity": 0.16 }
  },
  "legend": { "minBytesDefault": 0 },
  "demo": {
    "package": { "maxBytes": 95000000, "minLines": 0 },
    "repos": [
      { "name": "starmap", "file": "/demo/starmap.starmap.zip", "location": "github.com/GaryQian/gitmap" },
      { "name": "react", "file": "/demo/react.starmap.zip", "location": "github.com/facebook/react" },
      { "name": "tensorflow", "file": "/demo/tensorflow.starmap.zip", "location": "github.com/tensorflow/tensorflow" },
      { "name": "openclaw", "file": "/demo/openclaw.starmap.zip", "location": "github.com/openclaw/openclaw" }
    ]
  },
  "render": { "ambientEdges": 1500, "edgeBudget": 50000, "maxPills": 150, "patchBudgetMs": 4, "adaptiveDpr": true, "maxDpr": 2 },
  "interaction": { "jiggleMax": 0.35, "jiggleSettleMs": 800, "hoverDelayMs": 80 },
  "camera": { "minDistance": 10, "maxDistance": 5000, "flyMs": 900, "defaultTilt": 0.55 },
  "overlays": {
    "enabled": ["recency", "ownership", "reach", "knowledgeRisk", "tests"],
    "knowledgeRisk": { "minCommits": 3 },
    "tests": { "patterns": ["**/tests/**", "**/test/**", "**/__tests__/**", "**/*_test.*", "**/*.test.*", "**/*.spec.*", "**/*Test.java", "**/test_*.py"] }
  },
  "ai": {
    "enabled": true, "provider": "anthropic",
    "models": { "synthesis": "claude-opus-5-5", "tour": "claude-sonnet-5-5", "chat": "claude-sonnet-5-5", "bulk": "claude-haiku-5-5" },
    "openaiModels": { "synthesis": "gpt-6.2-astra", "tour": "gpt-6.1-terra", "chat": "gpt-6.1-terra", "bulk": "gpt-6-luna" },
    "excludePaths": [
      "**/.env*", "**/*.pem", "**/*.key", "**/id_rsa*", "**/id_dsa*", "**/id_ecdsa*", "**/id_ed25519*",
      "**/*.p12", "**/*.pfx", "**/*.jks", "**/*.keystore", "**/.npmrc", "**/.netrc", "**/.pypirc",
      "**/*.tfvars", "**/*.tfstate", "**/credentials*", "**/secrets.*", "**/secret.*", "**/.htpasswd"
    ],
    "digestTokens": 60000, "maxInputTokens": 120000, "maxDetailCallsPerDigest": 60,
    "budgetSplit": { "structure": 0.35, "skeletons": 0.35, "docs": 0.30 },
    "pois": { "perCity": 1, "repoWide": 3, "max": 15 },
    "tour": { "minSteps": 3, "maxSteps": 6 },
    "client": { "summaryConcurrency": 4, "reduceHeadStartMs": 3000, "maxRetryAfterSeconds": 5 }
  }
}
